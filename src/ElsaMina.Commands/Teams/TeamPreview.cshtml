@using ElsaMina.Commands.Teams
@using ElsaMina.Core.Utils
@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Teams.TeamPreviewViewModel>

@{
    var teamMembersCount = Math.Min(Model.Team.Count, 6);
}

<div style="display:inline-block;background:#1a1a2e;border-radius:6px;padding:1px;">
<div style="background:#1a1a2e;border-radius:6px;padding:8px 12px;font-size:11px;color:#e0e0e0;font-family:monospace;">
    <div style="margin-bottom:2px;">
        <span style="font-weight:bold;font-size:12px;color:@Model.Sender.ToColorHexCodeWithCustoms();">
            @GetString("team_preview_title", Model.Sender)
        </span>
        @if (!string.IsNullOrEmpty(Model.Author))
        {
            <span style="color:#a0a0c0;font-size:10px;">@GetString("team_preview_author", Model.Author)</span>
        }
    </div>
    <div style="color:#606080;font-size:10px;font-style:italic;margin-bottom:4px;">
        @GetString("team_preview_click_icons")
    </div>

    <details>
        <summary style="cursor:pointer;border-top:1px solid #2e2e4e;padding-top:4px;">
            @for (var i = 0; i < teamMembersCount; i++)
            {
                var set = Model.Team.ElementAt(i);
                <psicon pokemon="@set.Species" />
            }
        </summary>

        <table role="presentation" style="border-collapse:collapse;margin-top:4px;">
            @for (var i = 0; i < teamMembersCount; i += 2)
            {
                var set1 = Model.Team.ElementAtOrDefault(i);
                var set2 = Model.Team.ElementAtOrDefault(i + 1);
                <tr>
                    @if (set1 != null)
                    {
                        set1.Name = null;
                        <td style="padding:4px 16px 4px 4px;vertical-align:top;border-top:1px solid #2e2e4e;">
                            <span style="white-space:pre-line;color:#e0e0e0;">@ShowdownTeamsUtils.GetSetExport(set1).Trim()</span>
                        </td>
                    }
                    @if (set2 != null)
                    {
                        set2.Name = null;
                        <td style="padding:4px 4px 4px 4px;vertical-align:top;border-top:1px solid #2e2e4e;">
                            <span style="white-space:pre-line;color:#e0e0e0;">@ShowdownTeamsUtils.GetSetExport(set2).Trim()</span>
                        </td>
                    }
                </tr>
            }
        </table>

        <button name="copyText" value="@ShowdownTeamsUtils.GetTeamExport(Model.Team)" class="button" style="margin-top:6px;">
            @GetString("team_preview_copy")
        </button>
    </details>
</div>
</div>
