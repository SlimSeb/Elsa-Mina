@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Alerts.Youtube.YoutubeAlertViewModel>

<table style="padding: 0.25em;">
    <tr>
        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <td>
                <a href="https://www.youtube.com/watch?v=@Model.VideoId"><img src="@Model.ThumbnailUrl" width="160" height="90" alt="Thumbnail"/></a>
            </td>
        }
        <td style="padding: 0.5em; text-align: left;">
            <b style="color: #FF0000;">@GetString(Model.IsLive ? "alerts_youtube_live" : "alerts_youtube_video", Model.ChannelTitle)</b><br/>
            <span>@Model.Title</span><br/>
            <a href="https://www.youtube.com/watch?v=@Model.VideoId">@GetString(Model.IsLive ? "alerts_watch_stream" : "alerts_watch_video")</a>
        </td>
    </tr>
</table>
