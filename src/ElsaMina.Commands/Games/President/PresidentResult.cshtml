@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Games.President.PresidentViewModel>
@using ElsaMina.Commands.Games.President
@using ElsaMina.Core.Utils

@{
    var game = Model.Game;
    var standings = game.Players.OrderByDescending(player => player.Score).ToList();
    var topScore = standings.Count > 0 ? standings[0].Score : 0;
    var winners = standings.Where(player => player.Score == topScore).ToList();

    string RoleIcon(PresidentRole role) => role switch
    {
        PresidentRole.President => "👑",
        PresidentRole.VicePresident => "🎩",
        PresidentRole.ViceScum => "🧹",
        PresidentRole.Scum => "💩",
        _ => ""
    };
}

<div style="background:#1d2b35;color:#ece7f2;border:1px solid #3f5668;border-radius:6px;padding:10px">
    <h3 style="margin:0 0 8px 0;text-align:center">👑 @GetString("president_result_title")</h3>

    <p style="text-align:center;margin:4px 0;font-size:1.1em">
        @GetString("president_result_winner", string.Join(", ", winners.Select(player => player.Name)))
    </p>

    <table style="margin:8px auto 0 auto;border-collapse:collapse">
        <tr style="border-bottom:1px solid #3f5668">
            <th style="padding:2px 12px;text-align:left">@GetString("president_players_label")</th>
            <th style="padding:2px 12px">@GetString("president_result_last_role")</th>
            <th style="padding:2px 12px">@GetString("president_score_label")</th>
        </tr>
        @foreach (var player in standings)
        {
            <tr>
                <td style="padding:2px 12px;color:@player.Name.ToColorHexCodeWithCustoms()">@player.Name</td>
                <td style="padding:2px 12px;text-align:center">
                    @if (player.Role != PresidentRole.None)
                    {
                        <text>@RoleIcon(player.Role) @GetString($"president_role_{player.Role.ToString().ToLowerInvariant()}")</text>
                    }
                </td>
                <td style="padding:2px 12px;text-align:center;font-weight:bold;color:#6ddf9a">@player.Score</td>
            </tr>
        }
    </table>

    @if (game.Log.Count > 0)
    {
        <details style="margin-top:12px;background:#16222a;border:1px solid #3f5668;border-radius:5px">
            <summary style="cursor:pointer;padding:6px 8px;text-align:center;font-weight:bold">@GetString("president_log_title")</summary>
            <div style="padding:4px 10px 8px 10px;border-top:1px solid #3f5668">
                @foreach (var line in game.Log)
                {
                    <div style="margin:3px 0;font-size:0.85em;color:#a9bac9">@line</div>
                }
            </div>
        </details>
    }
</div>
