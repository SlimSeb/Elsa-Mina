@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Games.President.PresidentViewModel>
@using ElsaMina.Core.Utils

<div style="background:#1d2b35;color:white;padding:10px;border-radius:6px">
    <h3 style="margin:0;text-align:center">👑 @GetString("president_title") 👑</h3>
    <p style="text-align:center;margin:6px 0">@GetString("president_lobby_intro", Model.Game.TotalRounds)</p>

    <p style="text-align:center;margin:6px 0">
        <b>@GetString("president_players_label") (@Model.Game.PlayerCount/@ElsaMina.Commands.Games.President.PresidentConstants.MAX_PLAYERS):</b>
        @if (Model.Game.PlayerCount == 0)
        {
            <em>@GetString("president_lobby_no_players")</em>
        }
        else
        {
            foreach (var player in Model.Game.Players)
            {
                <b style="color:@player.Name.ToColorHexCodeWithCustoms()">@player.Name</b>
                <text>&nbsp;&nbsp;</text>
            }
        }
    </p>

    <p style="text-align:center;margin:6px 0">
        <button class="button" name="send" value="@(Model.Trigger)presidentjoin">@GetString("president_lobby_join_button")</button>
        <button class="button" name="send" value="@(Model.Trigger)presidentquit">@GetString("president_lobby_leave_button")</button>
        <button class="button" name="send" value="@(Model.Trigger)presidentstart">@GetString("president_lobby_start_button")</button>
    </p>
    <p style="text-align:center;color:#bbb;font-size:0.85em;margin:4px 0">
        @GetString("president_lobby_hint", Model.Trigger, ElsaMina.Commands.Games.President.PresidentConstants.MIN_PLAYERS)
    </p>
</div>
