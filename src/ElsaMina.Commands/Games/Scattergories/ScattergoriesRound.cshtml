@using ElsaMina.Core.Utils
@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Games.Scattergories.ScattergoriesModel>

<div style="background-color: #2f2b3a; color: white; padding: 12px; border-radius: 8px;">
    <div style="text-align: center;">
        <span style="font-size: 13px; color: #bcb3d6;">
            @GetString("scattergories_round_label", Model.RoundNumber, Model.TotalRounds)
        </span>
        <h3 style="margin: 4px 0;">
            @GetString("scattergories_prompt")
            <span style="display: inline-block; min-width: 44px; padding: 2px 10px; margin-left: 6px; background: #7c5cff; border-radius: 6px; font-size: 26px; vertical-align: middle;">@Model.Letter</span>
        </h3>
        @if (!Model.IsRoundOver)
        {
            <p style="margin: 4px 0; color: #cfc7e6;">@GetString("scattergories_instruction", Model.RoundDurationSeconds)</p>
        }
        else
        {
            <p style="margin: 4px 0; color: #ffd479;">
                <b>@GetString("scattergories_round_over")</b>
                &mdash; @GetString("scattergories_found_count", Model.Found.Count, Model.EligibleCount)
            </p>
        }
    </div>

    @if (Model.Found.Count > 0)
    {
        <div style="text-align: center; margin: 10px 0;">
            @foreach (var entry in Model.Found)
            {
                var color = entry.FinderName.ToColorHexCodeWithCustoms();
                <div style="display: inline-block; vertical-align: top; width: 92px; margin: 4px; padding: 4px; background: #3b374a; border-radius: 6px;">
                    @if (!string.IsNullOrEmpty(entry.SpriteUrl))
                    {
                        <img src="@entry.SpriteUrl" width="48" height="48" alt="@entry.DisplayName"><br>
                    }
                    <b style="font-size: 12px;">@entry.DisplayName</b><br>
                    <span style="font-size: 11px; color: @color;">@entry.FinderName</span>
                </div>
            }
        </div>
    }

    @if (Model.Scores.Count > 0)
    {
        <div style="text-align: center; margin-top: 8px;">
            <span style="text-decoration: underline; color: #bcb3d6;">@GetString("scattergories_scores")</span>
            <table style="margin: 6px auto 0; border-collapse: collapse;">
                @{
                    var rank = 1;
                }
                @foreach (var (name, points) in Model.Scores)
                {
                    var color = name.ToColorHexCodeWithCustoms();
                    <tr>
                        <td style="padding: 1px 6px; text-align: right; color: #8f86a8;">@rank.</td>
                        <td style="padding: 1px 6px; text-align: left;"><b style="color: @color;">@name</b></td>
                        <td style="padding: 1px 6px; text-align: right;">@points</td>
                    </tr>
                    rank++;
                }
            </table>
        </div>
    }
</div>
