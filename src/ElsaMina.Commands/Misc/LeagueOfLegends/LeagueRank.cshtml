@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Misc.LeagueOfLegends.LeagueRankViewModel>

<div style="display:inline-block;background:#091428;border:1px solid #785a28;border-radius:8px;padding:8px 12px;color:#f0e6d2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;box-shadow:0 2px 6px rgba(0,0,0,0.5);min-width:320px;max-width:440px;">
    <table style="width:100%;border-bottom:1px solid #1e282d;margin-bottom:6px;padding-bottom:4px;">
        <tr>
            <td style="text-align:left;font-size:13px;font-weight:bold;color:#f0e6d2;vertical-align:middle;">
                <span>@Model.GameName</span><span style="color:#a09b8c;font-weight:normal;">#@Model.TagLine</span>
            </td>
            <td style="text-align:right;vertical-align:middle;">
                <span style="font-size:10px;background:#1e282d;color:#c8aa6e;padding:2px 6px;border-radius:4px;font-weight:bold;text-transform:uppercase;border:1px solid #3c3c41;">
                    @Model.Platform
                </span>
            </td>
        </tr>
    </table>

    <table style="width:100%;border-collapse:collapse;">
        <tbody>
            @if (Model.SoloQueue != null)
            {
                <tr>
                    <td style="padding:4px 6px 4px 0;width:192px;text-align:center;vertical-align:middle;">
                        @if (!Model.SoloQueue.IsUnranked)
                        {
                            <img src="@Model.SoloQueue.EmblemUrl" width="192" height="108" alt="@Model.SoloQueue.Tier" style="display:block;margin:0 auto;" />
                        }
                        else
                        {
                            <img src="@Model.SoloQueue.EmblemUrl" width="48" height="48" alt="Unranked" style="display:block;margin:0 auto;" />
                        }
                    </td>
                    <td style="padding:4px 0;vertical-align:middle;">
                        <div style="font-size:11px;color:#a09b8c;font-weight:bold;text-transform:uppercase;letter-spacing:0.5px;">
                            @GetString("lolrank_solo_title")
                        </div>
                        @if (!Model.SoloQueue.IsUnranked)
                        {
                            <div style="font-size:13px;font-weight:bold;color:@Model.SoloQueue.TierColor;margin:1px 0;">
                                @Model.SoloQueue.FormattedRank <span style="font-size:11px;color:#c8aa6e;font-weight:normal;">(@Model.SoloQueue.LeaguePoints LP)</span>
                            </div>
                            <div style="font-size:11px;color:#cdbe91;">
                                <span style="color:#57c482;font-weight:bold;">@Model.SoloQueue.Wins</span>W 
                                <span style="color:#e84057;font-weight:bold;">@Model.SoloQueue.Losses</span>L
                                <span style="color:#a09b8c;"> · </span>
                                <span style="font-weight:bold;color:@(Model.SoloQueue.WinRate >= 50 ? "#57c482" : "#e84057");">@Model.SoloQueue.WinRate%</span>
                            </div>
                        }
                        else
                        {
                            <div style="font-size:12px;color:#7c8b9e;font-style:italic;margin-top:2px;">
                                @GetString("lolrank_unranked_queues")
                            </div>
                        }
                    </td>
                </tr>
            }
            @if (Model.FlexQueue != null)
            {
                @if (Model.SoloQueue != null)
                {
                    <tr>
                        <td colspan="2" style="border-top:1px solid #142032;padding:2px 0;"></td>
                    </tr>
                }
                <tr>
                    <td style="padding:4px 6px 4px 0;width:192px;text-align:center;vertical-align:middle;">
                        @if (!Model.FlexQueue.IsUnranked)
                        {
                            <img src="@Model.FlexQueue.EmblemUrl" width="192" height="108" alt="@Model.FlexQueue.Tier" style="display:block;margin:0 auto;" />
                        }
                        else
                        {
                            <img src="@Model.FlexQueue.EmblemUrl" width="48" height="48" alt="Unranked" style="display:block;margin:0 auto;" />
                        }
                    </td>
                    <td style="padding:4px 0;vertical-align:middle;">
                        <div style="font-size:11px;color:#a09b8c;font-weight:bold;text-transform:uppercase;letter-spacing:0.5px;">
                            @GetString("lolrank_flex_title")
                        </div>
                        @if (!Model.FlexQueue.IsUnranked)
                        {
                            <div style="font-size:13px;font-weight:bold;color:@Model.FlexQueue.TierColor;margin:1px 0;">
                                @Model.FlexQueue.FormattedRank <span style="font-size:11px;color:#c8aa6e;font-weight:normal;">(@Model.FlexQueue.LeaguePoints LP)</span>
                            </div>
                            <div style="font-size:11px;color:#cdbe91;">
                                <span style="color:#57c482;font-weight:bold;">@Model.FlexQueue.Wins</span>W 
                                <span style="color:#e84057;font-weight:bold;">@Model.FlexQueue.Losses</span>L
                                <span style="color:#a09b8c;"> · </span>
                                <span style="font-weight:bold;color:@(Model.FlexQueue.WinRate >= 50 ? "#57c482" : "#e84057");">@Model.FlexQueue.WinRate%</span>
                            </div>
                        }
                        else
                        {
                            <div style="font-size:12px;color:#7c8b9e;font-style:italic;margin-top:2px;">
                                @GetString("lolrank_unranked_queues")
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
