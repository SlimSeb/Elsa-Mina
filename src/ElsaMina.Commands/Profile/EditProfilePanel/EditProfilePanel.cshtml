@using ElsaMina.Commands.Profile.EditProfilePanel
@using ElsaMina.Core.Services.Templates
@inherits ElsaMina.Core.Services.Templates.LocalizableTemplatePage<ElsaMina.Commands.Profile.EditProfilePanel.EditProfilePanelViewModel>

@{
    const string containerStyle = "padding: 1.5rem; max-width: 700px;";
    const string sectionStyle = $"border: 1px solid {StyleConstants.PRIMARY_BORDER_COLOR};" +
                                "padding: .75rem 1rem;" +
                                "margin-bottom: 1rem;" +
                                $"background-color: {StyleConstants.PRIMARY_BACKGROUND_COLOR};";
    const string sectionTitleStyle = "font-weight: bold; margin-bottom: .5rem;";
    const string currentEmojiStyle = "font-size: 1.6em; margin-left: .5rem; vertical-align: middle;";
    const string colorSwatchStyle = "display: inline-block; width: 20px; height: 20px; border-radius: 3px;" +
                                    $"border: 1px solid {StyleConstants.PRIMARY_BORDER_COLOR}; vertical-align: middle; margin-right: 4px;";
    const string dollCellStyle = "text-align: center; padding: 0 .25rem;";
    // The pointer triangles are used instead of the play/reverse ones, which carry an emoji
    // presentation and end up with mismatched sizes. The fixed metrics keep both arrows identical.
    const string dollArrowStyle = "width: 1.8rem; padding: 0 .2rem; font-size: .8rem; line-height: 1.4;";
    const int colorColumns = 3;

    var flags = EditProfilePanelCommand.GetAllCountryFlags().ToList();

    // Background and text colors are picked the same way, so both swatch grids are rendered from
    // the same markup, each one wired to its own pair of set/clear commands.
    var colorSections = new[]
    {
        (
            TitleKey: "edit_profile_panel_bg_color_section",
            Current: Model.CurrentBackgroundColor,
            SetCommand: "setprofilecolor",
            ClearCommand: "clearprofilecolor",
            Colors: EditProfilePanelCommand.PROFILE_COLORS
        ),
        (
            TitleKey: "edit_profile_panel_text_color_section",
            Current: Model.CurrentTextColor,
            SetCommand: "setprofiletextcolor",
            ClearCommand: "clearprofiletextcolor",
            Colors: EditProfilePanelCommand.PROFILE_TEXT_COLORS
        )
    };
}

<div style="@containerStyle">
    <h2>@GetString("edit_profile_panel_title")</h2>

    <div style="@sectionStyle">
        <div style="@sectionTitleStyle">@GetString("edit_profile_panel_emoji_section")</div>
        <div>
            <span>@GetString("edit_profile_panel_current_emoji")</span>
            @if (!string.IsNullOrEmpty(Model.CurrentEmoji))
            {
                <span style="@currentEmojiStyle">@Model.CurrentEmoji</span>
                <button
                    class="button"
                    name="send"
                    value="/w @Model.BotName,@(Model.Trigger)clearemoji @Model.RoomId"
                    style="margin-left: .5rem; vertical-align: middle;">
                    @GetString("edit_profile_panel_clear")
                </button>
            }
            else
            {
                <em style="margin-left: .5rem;">@GetString("edit_profile_panel_no_emoji")</em>
            }
        </div>
        <form data-submitsend="/w @Model.BotName,@(Model.Trigger)setemoji @Model.RoomId, {flag}" style="margin-top: .5rem;">
            <select name="flag" class="textbox">
                @foreach (var (_, flag, name) in flags)
                {
                    <option value="@Raw(flag)">@flag @name</option>
                }
            </select>
            <button class="button" type="submit" style="margin-left: .35rem;">@GetString("submit")</button>
        </form>
    </div>

    @foreach (var colorSection in colorSections)
    {
        <div style="@sectionStyle">
            <div style="@sectionTitleStyle">@GetString(colorSection.TitleKey)</div>
            <div style="margin-bottom: .4rem;">
                <span>@GetString("edit_profile_panel_current_emoji")</span>
                @if (!string.IsNullOrEmpty(colorSection.Current))
                {
                    <span style="@colorSwatchStyle background: @colorSection.Current;"></span>
                }
                else
                {
                    <em style="margin-left: .5rem;">@GetString("edit_profile_panel_no_color")</em>
                }
            </div>
            <table style="border-collapse: separate; border-spacing: .3rem; margin-top: .35rem; table-layout: fixed; width: 100%;">
                <tbody>
                @{
                    var colorEntries = colorSection.Colors
                        .Select(kvp => (kvp.Key, kvp.Value))
                        .Append((Key: string.Empty, Value: string.Empty))
                        .ToList();
                }
                @for (var i = 0; i < colorEntries.Count; i += colorColumns)
                {
                    <tr>
                        @for (var j = i; j < Math.Min(i + colorColumns, colorEntries.Count); j++)
                        {
                            var (colorKey, colorValue) = colorEntries[j];
                            var isClear = string.IsNullOrEmpty(colorKey);
                            var commandName = isClear ? colorSection.ClearCommand : colorSection.SetCommand;
                            var sendValue = isClear
                                ? $"/w {Model.BotName},{Model.Trigger}{commandName} {Model.RoomId}"
                                : $"/w {Model.BotName},{Model.Trigger}{commandName} {Model.RoomId}, {colorKey}";
                            var swatchBg = isClear ? "transparent" : colorValue;
                            var label = isClear ? GetString("edit_profile_panel_clear") : GetString($"color_{colorKey}");
                            <td>
                                <button
                                    class="button"
                                    name="send"
                                    value="@sendValue"
                                    style="width: 100%; text-align: left;">
                                    <span style="@colorSwatchStyle background: @swatchBg;"></span>
                                    @label
                                </button>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div style="@sectionStyle">
        <div style="@sectionTitleStyle">@GetString("edit_profile_panel_dolls_section")</div>
        @if (Model.Dolls == null || Model.Dolls.Count == 0)
        {
            <em>@GetString("edit_profile_panel_no_dolls")</em>
        }
        else
        {
            <div style="margin-bottom: .4rem;">@GetString("edit_profile_panel_dolls_hint")</div>
            @* The sprites sit on the same row as on the profile, with their arrows right underneath,
               so the panel doubles as a preview of the shelf being reordered. *@
            <div style="overflow-x: auto;">
                <table style="border-collapse: collapse;">
                    <tbody>
                    <tr>
                        @foreach (var doll in Model.Dolls)
                        {
                            <td style="@dollCellStyle vertical-align: bottom;">
                                @{ await IncludeAsync("Dolls/Doll", doll); }
                            </td>
                        }
                    </tr>
                    <tr>
                        @for (var i = 0; i < Model.Dolls.Count; i++)
                        {
                            var doll = Model.Dolls[i];
                            <td style="@dollCellStyle padding-top: .25rem; white-space: nowrap;">
                                @if (i > 0)
                                {
                                    <button
                                        class="button"
                                        name="send"
                                        value="/w @Model.BotName,@(Model.Trigger)movedoll @doll.Id, left, @Model.RoomId"
                                        title="@GetString("edit_profile_panel_move_left")"
                                        style="@dollArrowStyle">
                                        &#9668;
                                    </button>
                                }
                                @if (i < Model.Dolls.Count - 1)
                                {
                                    <button
                                        class="button"
                                        name="send"
                                        value="/w @Model.BotName,@(Model.Trigger)movedoll @doll.Id, right, @Model.RoomId"
                                        title="@GetString("edit_profile_panel_move_right")"
                                        style="@dollArrowStyle">
                                        &#9658;
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
